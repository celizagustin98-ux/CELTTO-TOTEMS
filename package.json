{
  "name": "celtto-totems",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "CELTTO-TOTEMS: gestión de turnos con tótem, panel de secretaria, llamador y pantalla de sala (Linux/Docker + PostgreSQL)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/index.js",
    "migrate": "tsx src/server/cli.ts migrate",
    "owner:create": "tsx src/server/cli.ts owner:create",
    "seed:demo": "tsx src/server/cli.ts seed:demo",
    "db:check": "tsx src/server/cli.ts db:check",
    "db:script": "tsx src/server/cli.ts db:script",
    "test": "tsx --test tests/api.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "migrate:prod": "node dist/server/cli.js migrate",
    "owner:create:prod": "node dist/server/cli.js owner:create",
    "dev": "node scripts/dev.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "framer-motion": "^12.23.12",
    "i18next": "^27.2.10",
    "ioredis": "^5.6.1",
    "kysely": "^0.29.9",
    "lucide-react": "^1.73.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.5",
    "tarn": "^3.1.2",
    "tedious": "^20.3.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.1",
    "@electric-sql/pglite-socket": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.2.0"
  }
}
