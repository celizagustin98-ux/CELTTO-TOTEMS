# ===== CELTTO-TOTEMS: configuración =====
PORT=8080
HOST=0.0.0.0
APP_TIMEZONE=America/Argentina/Cordoba

# --- Base de datos por defecto: PostgreSQL (Linux / Docker / Proxmox) ---
DB_CLIENT=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=celtto_totems
POSTGRES_USER=celtto
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_SSL=false

# --- Futuro: SQL Server en Windows (descomentar y comentar el bloque de arriba) ---
# DB_CLIENT=mssql
# MSSQL_SERVER=192.168.0.10
# MSSQL_PORT=1433
# MSSQL_INSTANCE=SQLEXPRESS
# MSSQL_DATABASE=celtto_totems
# MSSQL_USER=celtto_app
# MSSQL_PASSWORD=cambiar-esta-clave
# MSSQL_ENCRYPT=false
# MSSQL_TRUST_CERT=true

# --- Desarrollo local sin servidor de base (SQLite) ---
# DB_CLIENT=sqlite
# SQLITE_PATH=./data/celtto.db

# false en producción hasta que el sistema esté detrás de HTTPS
COOKIE_SECURE=false
SESSION_HOURS=12
# En Docker/Postgres las migraciones se aplican al iniciar si está en true
AUTO_MIGRATE=true
LOG_HTTP=true
REDIS_URL=
