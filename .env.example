# Copiá a .env y completá. NUNCA subas .env a git.

NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_TIMEZONE=America/Argentina/Cordoba

# Imagen para docker-compose.prod.yml
CELTTO_IMAGE=ghcr.io/tu-usuario/celtto-totems:0.0.1

DB_CLIENT=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=celtto_totems
POSTGRES_USER=celtto
POSTGRES_PASSWORD=
POSTGRES_SSL=false
PG_POOL_MAX=20

REDIS_URL=redis://redis:6379

# Obligatorio en producción (>= 32 caracteres aleatorios)
SESSION_SECRET=
# Clave para cifrar los DNI y el doble factor (>= 32 caracteres). GUARDALA junto con los respaldos:
# sin ella, los datos cifrados de una copia no se pueden leer.
DATA_KEY=
# Opcional: token para /api/metrics (Prometheus/Grafana)
METRICS_TOKEN=
# Respaldos: días que se conservan las copias diarias y hora del respaldo
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=02
COOKIE_SECURE=true
SESSION_HOURS=12
AUTO_MIGRATE=true
LOG_HTTP=false

# Cantidad de proxies delante de la app (1 con el Caddy del compose). 0/false si se expone directo
TRUST_PROXY=false
WS_MAX_CLIENTS=2000
WS_MAX_PER_IP=60

TICKET_RATE_PER_MIN=120
TICKET_RATE_PER_DEVICE=30
HTTP_PORT=8080
