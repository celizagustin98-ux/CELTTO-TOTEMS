# Copiá a .env y completá. NUNCA subas .env a git.

NODE_ENV=production
PORT=8080
HOST=0.0.0.0
APP_TIMEZONE=America/Argentina/Cordoba

# Imagen para docker-compose.prod.yml
CELTTO_IMAGE=ghcr.io/tu-usuario/celtto-totems:0.0.1

DB_CLIENT=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DATABASE=celtto_totems
POSTGRES_USER=celtto
POSTGRES_PASSWORD=
POSTGRES_SSL=false
PG_POOL_MAX=20

REDIS_URL=redis://redis:6379

# Obligatorio en producción (>= 32 caracteres aleatorios)
SESSION_SECRET=
COOKIE_SECURE=true
SESSION_HOURS=12
AUTO_MIGRATE=true
LOG_HTTP=false

TICKET_RATE_PER_MIN=120
TICKET_RATE_PER_DEVICE=30
HTTP_PORT=8080
